# Copy to .env and fill in. .env is gitignored; this file is not, so it must never
# contain a real key.
#
#   cp .env.example .env && chmod 600 .env

# The LLM-judge adapter talks to an OpenAI-compatible chat endpoint. Any such endpoint
# works: a hosted service, a local vLLM or Ollama server, whatever you have. Ours ran on
# an institutional vLLM host that no longer exists, so the URL below is a placeholder.
LLM_BASE_URL=https://your-endpoint.example/api
OLLAMA_API_KEY=

# Pin the judge model. A judge whose weights change between runs produces numbers that
# cannot be reproduced, which is the failure this paper is about. The published results
# used a Gemma-class 31B instruct model; record whatever you use in the adapter version.
LLM_MODEL=
LLM_MODEL_CODE=

# Hugging Face token, only needed if a scoring model you substitute is gated. None of
# the models used in the published runs require one.
HF_TOKEN=
