# Copy to .env and fill in. .env is gitignored; this file is not, so it must never
# contain a real key.
#
#   cp .env.example .env && chmod 600 .env

# OpenWebUI proxy in front of the H100 host. Reachable from anywhere.
OLLAMA_URL=https://openwebui.ai.ustp.at/ollama
OLLAMA_API_KEY=

# Direct access to the H100 host, FH network or VPN only. Usually needs no API key.
# Faster, since it skips the proxy; use it for the long scoring runs when on site.
# OLLAMA_URL=http://10.203.222.234:11434

# Model served for the llm_judge adapter. Pin it: a judge whose model changes
# underneath produces scores that cannot be reproduced.
OLLAMA_MODEL=

# Hugging Face token, for the gated Llama-3 weights used by the zero-shot detectors.
HF_TOKEN=
