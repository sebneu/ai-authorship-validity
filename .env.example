# Copy to .env and fill in. .env is gitignored; this file is not, so it must never
# contain a real key.
#
#   cp .env.example .env && chmod 600 .env

# The H100 host runs vLLM behind OpenWebUI, not Ollama. The /ollama path answers but
# serves no models, so the working route is OpenWebUI's own /api. Set LLM_BASE_URL
# directly; OLLAMA_URL is only kept because other scripts already read it.
LLM_BASE_URL=https://openwebui.ai.ustp.at/api
OLLAMA_URL=https://openwebui.ai.ustp.at/ollama
OLLAMA_API_KEY=

# Direct access to the H100 host, FH network or VPN only, usually without a key.
# LLM_BASE_URL=http://10.203.222.234:8000/v1

# Models served as of 2026-08-03:
#   vllm/gemma-4-31B-it         general instruct, no reasoning overhead
#   vllm/Qwen3-Coder-Next-FP8   code-specialised
#   vllm/Qwen3.6-27B-FP8        reasoning model; needs thinking disabled
#
# Pin both. A judge whose weights change between runs produces numbers that cannot be
# reproduced, which is the failure this paper is about.
LLM_MODEL=vllm/gemma-4-31B-it
LLM_MODEL_CODE=vllm/Qwen3-Coder-Next-FP8

# Hugging Face token, for the gated Llama-3 weights used by the zero-shot detectors.
HF_TOKEN=
