# --- Planning notes / instructions (local only) ---
instructions/

# --- Data (document provenance in data/README.md, never commit payloads) ---
data/*
!data/README.md

# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Credentials (never commit) ---
.env
.env.*
!.env.example
*.key
*_token

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Models / caches ---
.cache/
*.pt
*.safetensors

